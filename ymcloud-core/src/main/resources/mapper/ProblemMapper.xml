<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ymcloud.core.web.mapper.ProblemMapper">

    <!-- 查询并锁定当前最大的本地题目展示id -->
    <select id="selectLatestLocalProblemIdForUpdate" resultType="java.lang.String">
        SELECT problem_id
        FROM problem
        WHERE source = #{source}
          AND problem_id REGEXP '^YMOJ-[0-9]+$'
        ORDER BY CAST(SUBSTRING(problem_id, 6) AS UNSIGNED) DESC
        LIMIT 1
        FOR UPDATE
    </select>

    <!-- Result Map 定义 -->
    <resultMap id="problemTableMap" type="com.ymcloud.pojo.vo.oj.ProblemTableVO">
        <id column="id" />
        <result column="problem_id" property="problemId"/>
        <result column="source" property="source"/>
        <result column="title" property="title"/>
        <result column="difficulty" property="difficulty"/>
        <collection property="tagList" ofType="com.ymcloud.pojo.entity.Tag"
                    select="getTagsByProblemId" column="id">
        </collection>
    </resultMap>

    <!-- 主查询 -->
    <select id="pageQuery" resultMap="problemTableMap">
        SELECT
            p.id,
            p.problem_id,
            p.title,
            p.difficulty,
            p.source
        FROM
            problem p
        <where>
            p.visibility = 1
            <if test="keyword != null and keyword.trim() != ''">
                AND (
                    p.problem_id LIKE CONCAT('%', #{keyword}, '%')
                    OR p.title LIKE CONCAT('%', #{keyword}, '%')
                )
            </if>
            <if test="difficulty != null and difficulty >=0 ">
                AND p.difficulty = #{difficulty}
            </if>
            <if test="source != null">
                AND p.source = #{source}
            </if>
        </where>
    </select>

    <!-- 子查询：获取问题的标签列表 -->
    <select id="getTagsByProblemId" resultType="com.ymcloud.pojo.entity.Tag">
        SELECT t.*
        FROM tag t
        LEFT JOIN problem_tag pt ON t.id = pt.tag_id
        WHERE pt.problem_id = #{id}
    </select>

</mapper>
