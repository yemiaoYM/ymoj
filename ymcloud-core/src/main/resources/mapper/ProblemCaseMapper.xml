<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ymcloud.core.web.mapper.ProblemCaseMapper">

    <select id="getByProblemIdAndIsSample" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List"/>
        from problem_case
        where
        problem_id = #{problemId,jdbcType=NUMERIC}
        AND is_sample = #{isSample,jdbcType=NUMERIC}
    </select>
</mapper>
