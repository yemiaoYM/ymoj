<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ymcloud.core.web.mapper.StorageConfigStateMapper">
    <select id="getForLock" resultType="com.ymcloud.pojo.entity.StorageConfigState">
        SELECT * FROM storage_config_state WHERE id = 1
        <choose>
            <when test="exclusive">FOR UPDATE</when>
            <otherwise>LOCK IN SHARE MODE</otherwise>
        </choose>
    </select>
</mapper>
