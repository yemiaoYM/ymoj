# Run initialize.ps1 to generate .env and secrets/s3.json. Do not use these placeholders.
SEAWEEDFS_IMAGE=chrislusf/seaweedfs:4.48
YMCLOUD_S3_PORT=18333
YMCLOUD_S3_ENDPOINT=http://127.0.0.1:18333
YMCLOUD_S3_REGION=us-east-1
YMCLOUD_S3_PUBLIC_BUCKET=ymcloud-public
YMCLOUD_S3_PRIVATE_BUCKET=ymcloud-private
YMCLOUD_S3_ACCESS_KEY=generated-by-initialize
YMCLOUD_S3_SECRET_KEY=generated-by-initialize
YMCLOUD_S3_ADMIN_ACCESS_KEY=generated-by-initialize
YMCLOUD_S3_ADMIN_SECRET_KEY=generated-by-initialize
