# 复制为本目录 .env（已忽略），所有真实凭据均只保留在部署主机。
# 镜像 ID 由 build.sh 写入 target/phase3-verification/images.env，不手填 tag。
YMCLOUD_GO_JUDGE_TOKEN=
YMCLOUD_WORKER_SERVICE_TOKEN=
YMCLOUD_GO_JUDGE_CACHE_DIR=/srv/ymcloud/go-judge
YMCLOUD_WORKER_DATA_DIR=/srv/ymcloud/worker
YMCLOUD_WORKER_ID=judge-1
YMCLOUD_WORKER_API_URL=http://127.0.0.1:9091
# 0 自动取各自的可用 CPU 数，Worker 最大任务数在自身 CPU 数上加 1
YMCLOUD_WORKER_CONCURRENCY=0
YMCLOUD_GO_JUDGE_CONCURRENCY=0
YMCLOUD_GO_JUDGE_CPUS=1.0
YMCLOUD_GO_JUDGE_CPU_RATE=1000
YMCLOUD_GO_JUDGE_SERVICE_MEMORY_BYTES=1073741824
YMCLOUD_GO_JUDGE_SERVICE_PIDS=256
YMCLOUD_GO_JUDGE_FILE_TTL_SECONDS=3600
YMCLOUD_GO_JUDGE_MAX_MEMORY_KIB=524288
YMCLOUD_GO_JUDGE_COMPILE_MEMORY_BYTES=536870912
YMCLOUD_GO_JUDGE_COMPILE_WALL_MS=10000
YMCLOUD_GO_JUDGE_PROCESS_LIMIT=64
YMCLOUD_GO_JUDGE_MAX_FILE_BYTES=67108864
YMCLOUD_GO_JUDGE_MAX_OUTPUT_BYTES=33554432
YMCLOUD_GO_JUDGE_MAX_REQUEST_BYTES=68157440
YMCLOUD_GO_JUDGE_MAX_RESPONSE_BYTES=8388608
YMCLOUD_GO_JUDGE_REQUEST_TIMEOUT=90s
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=ymcloud
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=/
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
YMCLOUD_JUDGE_EXCHANGE=judge.worker-v2.topic
YMCLOUD_JUDGE_TASK_QUEUE=judge.worker-v2.queue
YMCLOUD_JUDGE_RESULT_QUEUE=judge.worker-v2.result.queue
YMCLOUD_WORKER_REDIS_PREFIX=ymcloud:judge-worker-v2:
